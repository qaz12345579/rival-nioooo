-- [[ OPTIMIZED PHYSICS INJECTION ]]

local function SendSilentPacket()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- Use Assembly properties to disrupt nearby client interpolation
        for i = 1, math.floor(_G.Intensity / 10) do
            -- These values are calculated to be right below the 'Auto-Kick' threshold
            hrp.AssemblyLinearVelocity = Vector3.new(0, 50000, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(50000, 50000, 50000)
            
            -- Small CFrame shift to force server-wide replication
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 0.00001, 0)
        end
        -- Reset to prevent local character glitching
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
end

-- Use Heartbeat for stability and PreSimulation for packet priority
RunService.Heartbeat:Connect(function()
    if _G.AttackActive then
        -- Lower simulation radius to prevent local data overflow (prevents Pause)
        sethiddenproperty(LocalPlayer, "SimulationRadius", 500)
        sethiddenproperty(LocalPlayer, "MaxSimulationRadius", 500)
        
        task.spawn(SendSilentPacket)
    end
end)

