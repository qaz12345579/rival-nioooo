local RunService = game:GetService("RunService")
local LocalPlayer = game:GetService("Players").LocalPlayer

getgenv().TowerLogic = {
    Enabled = true,
    Range = 1000,
    -- Using oscillating values to bypass server-side clamping
    Frequency = 0.5 
}

local function BreakTowerLogic()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp and getgenv().TowerLogic.Enabled then
        -- 1. Anti-Clamp Velocity: High but fluctuating to stay under auto-drop
        local drift = math.sin(tick() * 10) * 5000
        hrp.AssemblyLinearVelocity = Vector3.new(drift, 10000, drift)
        
        -- 2. CFrame Desync: Teleporting between two points in 1 frame
        -- This forces the server to re-calculate physics for everyone nearby
        local originalCF = hrp.CFrame
        hrp.CFrame = originalCF * CFrame.new(0, 50, 0) -- Fake height
        
        -- Bypass Network Ownership check
        pcall(function()
            settings().Physics.AllowSleep = false
            sethiddenproperty(LocalPlayer, "SimulationRadius", getgenv().TowerLogic.Range)
        end)
    end
end

-- Optimization: Using Stepped to sync with Physics Engine precisely
RunService.Stepped:Connect(function()
    if getgenv().TowerLogic.Enabled then
        task.spawn(BreakTowerLogic)
    end
end)

